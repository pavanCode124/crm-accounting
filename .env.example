# Copy to .env.local and fill in. `.env*.local` is gitignored.

# ---------------------------------------------------------------------------
# The ledger's database
# ---------------------------------------------------------------------------
# The Postgres inside your self-hosted Supabase — the same database TripzoCRM
# uses. This app creates and owns ONE schema in it (`accounting`); the CRM's own
# tables live in `public` and are never written to.
#
# Self-hosted Supabase keeps the password in its own .env as POSTGRES_PASSWORD;
# Studio shows the assembled string under Project Settings -> Database.
# Add `?sslmode=disable` for a local instance with no TLS.
#
# LEAVE THIS UNSET (or comment it out) TO RUN A DEMO. With no connection string
# the ledger runs on an embedded in-memory Postgres, seeded with sample books,
# with CRM sync switched off — nothing can reach a live agency. See the README.
#
# SERVER-SIDE ONLY. Never expose this as NEXT_PUBLIC_*.
TRIPZO_DATABASE_URL=postgresql://postgres:PASSWORD@supa.tripzocrm.cloud:5432/postgres

# Schema the ledger lives in. Change it only to run a second set of books
# against the same database — a staging ledger beside the real one, say.
# TRIPZO_DB_SCHEMA=accounting

# ---------------------------------------------------------------------------
# TripzoCRM, for Settings -> CRM Sync
# ---------------------------------------------------------------------------
# Copied from tripzo-crm-mobile/.env. These are the same values that get inlined
# into the mobile bundle, so they are public by design -- the anon key grants
# nothing on its own; every /api/* call is authorised by the signed-in user's
# own token, which is why the sync screen asks the accountant to sign in.
# Comment all three out for a demo: the CRM Sync screen then says so and its
# Connect button is disabled, rather than failing when someone presses it.
TRIPZO_SUPABASE_URL=https://supa.tripzocrm.cloud
TRIPZO_SUPABASE_ANON_KEY=
TRIPZO_BACKEND_URL=https://api.tripzocrm.cloud

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Sign in as a particular seeded user, to see the product at a different role.
# TRIPZO_USER=
# Configuration only, no demo trading.
# TRIPZO_SEED_DEMO=0
